{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "note": "RollCall design tokens — REVISED direction (2026-10-27, owner). Primary style now = S4 soft-rounded bento + S3 bold rounded type & bright chips: white background, large-radius filled bento cards with soft shadows, a dark floating pill bottom nav. Raw colours sampled from S3/S4 via sample_colors.py (approximate, JPEG). Validated by check_contrast.py (WCAG AA). Light is authored; dark is derived.",
    "sources": { "S4": "primary — bento cards, floating dark nav, lilac/orange/blue (credit: ronasit.com, layout/style only)", "S3": "bold rounded type, bright chips", "S1/S2": "retired as primary; S1 date-numeral idea optional" }
  },
  "color": {
    "raw": {
      "white":      { "$value": "#FFFFFF", "$type": "color" },
      "bg-lilac":   { "$value": "#FAF9FE", "$type": "color", "_note": "near-white with S4 lilac tint" },
      "ink":        { "$value": "#141417", "$type": "color", "_from": "S3 #0D0C0C / S4 #121317" },
      "ink-muted":  { "$value": "#67676E", "$type": "color", "_note": "darkened for AA on white" },
      "ink-faint":  { "$value": "#9A9AA1", "$type": "color" },
      "lavender":   { "$value": "#CBB5F7", "$type": "color", "_from": "S4 9.3%" },
      "purple":     { "$value": "#ADA0F1", "$type": "color", "_from": "S4 3.1%" },
      "orange":     { "$value": "#F7B858", "$type": "color", "_from": "S4 3.4%" },
      "blue":       { "$value": "#AACBFC", "$type": "color", "_from": "S4 1.2% / S3 #A5CAF7" },
      "green":      { "$value": "#B3F4A5", "$type": "color", "_from": "S3 4.4%" },
      "pink":       { "$value": "#F2A7D3", "$type": "color", "_note": "S4 social card pink" },
      "yellow":     { "$value": "#F5D655", "$type": "color", "_from": "S3 0.5%" },
      "peach":      { "$value": "#EF9D90", "$type": "color", "_from": "S3 #EF9D90" },
      "nav-dark":   { "$value": "#17171B", "$type": "color", "_note": "S3/S4 dark floating nav" },
      "green-ink":  { "$value": "#1E7A43", "$type": "color", "_note": "safe text/meter on light" },
      "amber-ink":  { "$value": "#8A5A00", "$type": "color", "_note": "warn text on light" },
      "red-ink":    { "$value": "#B23A22", "$type": "color", "_note": "risk text on light" }
    },
    "semantic": {
      "bg":              { "$value": "{color.raw.bg-lilac}", "$type": "color" },
      "surface":         { "$value": "{color.raw.white}", "$type": "color" },
      "ink":             { "$value": "{color.raw.ink}", "$type": "color" },
      "ink-muted":       { "$value": "{color.raw.ink-muted}", "$type": "color" },
      "nav-surface":     { "$value": "{color.raw.nav-dark}", "$type": "color" },
      "nav-ink":         { "$value": "{color.raw.white}", "$type": "color" },
      "accent-attendance": { "$value": "{color.raw.green}", "$type": "color", "_note": "fill; text on it = ink" },
      "accent-schedule":   { "$value": "{color.raw.lavender}", "$type": "color" },
      "accent-marks":      { "$value": "{color.raw.orange}", "$type": "color" },
      "accent-calendar":   { "$value": "{color.raw.blue}", "$type": "color" },
      "accent-hero":       { "$value": "{color.raw.purple}", "$type": "color", "_note": "S4 'daily challenge' hero" },
      "status-safe":     { "$value": "{color.raw.green-ink}", "$type": "color" },
      "status-safe-fill":{ "$value": "{color.raw.green}", "$type": "color" },
      "status-warn":     { "$value": "{color.raw.amber-ink}", "$type": "color" },
      "status-warn-fill":{ "$value": "{color.raw.orange}", "$type": "color" },
      "status-risk":     { "$value": "{color.raw.red-ink}", "$type": "color" },
      "status-risk-fill":{ "$value": "{color.raw.peach}", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "'Poppins', system-ui, sans-serif", "$type": "fontFamily", "_note": "bold rounded headings (S3/S4). OFL." },
      "body":    { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "_note": "OFL." }
    },
    "scale": {
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "14px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "20px", "$type": "dimension" },
      "xl": { "$value": "28px", "$type": "dimension" },
      "2xl": { "$value": "40px", "$type": "dimension" },
      "display": { "$value": "56px", "$type": "dimension", "_note": "bold rounded hero number" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "12px", "$type": "dimension" },
    "md": { "$value": "20px", "$type": "dimension" },
    "lg": { "$value": "28px", "$type": "dimension", "_note": "S4 bento cards" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "border": { "width": { "$value": "0px", "$type": "dimension", "_note": "S3/S4 use shadows, not outlines" } },
  "shadow": {
    "card": { "$value": "0 6px 20px rgba(20,20,30,0.08)", "$type": "shadow", "_note": "soft bento elevation" },
    "nav":  { "$value": "0 8px 24px rgba(20,20,30,0.18)", "$type": "shadow" }
  },
  "layout": {
    "gutter": { "$value": "16px", "$type": "dimension" },
    "bottom-nav-height": { "$value": "68px", "$type": "dimension" },
    "max-width": { "$value": "1200px", "$type": "dimension" }
  }
}
